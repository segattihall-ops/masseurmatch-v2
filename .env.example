# ---------------------------------------------------------------------------
# MasseurMatch — environment variable reference
# ---------------------------------------------------------------------------
# Copy to `.env.local` inside the app you are running (apps/web or
# apps/dashboard) and fill in real values there. `.env*` is gitignored;
# this file documents NAMES ONLY and must never contain real values.
#
#   cp .env.example apps/web/.env.local
#   cp .env.example apps/dashboard/.env.local
#
# Legend:
#   [required]  the app will not boot / build correctly without it
#   [optional]  feature-gated; the related feature is disabled when unset
#   NEXT_PUBLIC_*  is inlined into the browser bundle — never put a secret here
# ---------------------------------------------------------------------------


# --- Core URLs -------------------------------------------------------------
# [required in production] Public origin of the marketing/directory site
# (apps/web). Drives every canonical, OpenGraph URL and sitemap entry.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL, then VERCEL_URL,
# both set automatically; locally it falls back to http://localhost:3000.
# Set it explicitly for the real domain — the fallbacks are a safety net, not
# a substitute, and a wrong canonical host is invisible to Lighthouse.
NEXT_PUBLIC_SITE_URL=
# [required] Public origin of the therapist + admin dashboard (apps/dashboard).
NEXT_PUBLIC_DASHBOARD_URL=
# [optional] Cookie domain shared by both apps, e.g. ".example.com".
COOKIE_DOMAIN=


# --- Supabase --------------------------------------------------------------
# [required] Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# [required] Anon/publishable key. Safe for the browser; RLS must be enabled.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# [required, server only] Service-role key. Bypasses RLS — never expose it to
# the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# [optional] Project ref used by `pnpm db:types`.
SUPABASE_PROJECT_ID=
# [optional] Access token for the Supabase CLI when generating types in CI.
SUPABASE_ACCESS_TOKEN=
# [optional, server only] Direct Postgres connection string, used by
# `pnpm db:audit-rls`. Contains the database password — never commit it.
SUPABASE_DB_URL=


# --- RLS test fixtures (optional; tests skip when unset) -------------------
# Credentials of a therapist account used to prove cross-tenant writes fail.
# Point these at a STAGING project, never production.
TEST_THERAPIST_A_EMAIL=
TEST_THERAPIST_A_PASSWORD=
# A profile id owned by a *different* therapist than the account above.
TEST_THERAPIST_B_PROFILE_ID=
# City slug used by the ranking test. Defaults to the first city in the table.
TEST_CITY_SLUG=


# --- Auth / session --------------------------------------------------------
# [required, server only] Secret used to sign session cookies.
SESSION_SECRET=
# [required, server only] Secret used to derive CSRF tokens.
CSRF_SECRET=


# --- Stripe (billing + identity verification) ------------------------------
# [optional, server only] Stripe secret key.
STRIPE_SECRET_KEY=
# [optional] Stripe publishable key (browser).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# [optional, server only] Signing secret for the Stripe webhook endpoint.
STRIPE_WEBHOOK_SECRET=
# [optional, server only] Restricted key scoped to Stripe Identity.
STRIPE_IDENTITY_RESTRICTED_KEY=
# [optional] Price IDs for each subscription tier.
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ELITE=


# --- Media (Cloudinary) ----------------------------------------------------
# [optional] Cloud name — used to build public image URLs (browser safe).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# [optional, server only] Signed-upload credentials.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# --- Transactional email (Resend) ------------------------------------------
# [optional, server only]
RESEND_API_KEY=
# [optional] Verified sender address, e.g. "MasseurMatch <no-reply@example.com>".
RESEND_FROM_EMAIL=
# [optional] Inbox that receives admin/ops notifications.
ADMIN_NOTIFICATION_EMAIL=


# --- SMS / phone verification (Twilio) -------------------------------------
# [optional, server only]
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_PHONE_NUMBER=


# --- Maps / geocoding ------------------------------------------------------
# [optional] Browser-side Maps key. Restrict it by HTTP referrer.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=


# --- AI providers ----------------------------------------------------------
# [optional, server only]
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=


# --- Content moderation ----------------------------------------------------
# [optional, server only] Sightengine image moderation.
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=


# --- Internal automation ---------------------------------------------------
# [optional, server only] Shared secret required by /api/cron/* routes.
CRON_SECRET=
# [optional, server only] Shared secret required by on-demand revalidation.
REVALIDATE_SECRET=
# [optional, server only] Shared secret for service-to-service API calls.
INTERNAL_API_KEY=


# --- Web push --------------------------------------------------------------
# [optional] VAPID public key (browser).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# [optional, server only] VAPID private key.
VAPID_PRIVATE_KEY=


# --- Analytics / monitoring ------------------------------------------------
# [optional] Google Analytics measurement ID, e.g. G-XXXXXXX.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# [optional] Google Tag Manager container ID, e.g. GTM-XXXXXXX.
NEXT_PUBLIC_GTM_ID=
# [optional] Error-reporting client key.
NEXT_PUBLIC_BUGSNAG_API_KEY=


# --- Billing (packages/billing) --------------------------------------------
# [optional] Active payment provider: "authorizenet" (default) or "paypal".
# An unrecognised value throws at startup rather than silently falling back —
# taking payments through the wrong processor is worse than refusing to start.
BILLING_PROVIDER=
# [required for authorizenet, server only] HMAC-SHA512 key used to verify
# webhook signatures. Without it every webhook is rejected as unsigned.
AUTHORIZENET_SIGNATURE_KEY=
# [required for authorizenet, server only] ARB API credentials.
AUTHORIZENET_API_LOGIN_ID=
AUTHORIZENET_TRANSACTION_KEY=
# [required for paypal, server only] Subscriptions API + webhook verification.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# [optional] Defaults to https://api-m.paypal.com. Point at
# https://api-m.sandbox.paypal.com for the sandbox.
PAYPAL_API_BASE=
# [required for paypal, server only] PayPal's own plan id per paid tier, e.g.
# P-5ML4271244454362. Created in the PayPal dashboard (Products > Subscriptions)
# or via the Catalog API — they cannot be derived from our plan names.
#
# packages/billing/plans.ts stays the source of truth for what a tier costs and
# includes, but PayPal charges whatever its own plan says. Set the price in the
# PayPal dashboard to match plans.ts, and change a price by creating a NEW
# PayPal plan and repointing the variable — editing a live plan's price
# re-prices existing subscribers.
#
# A tier with no id set cannot be purchased: createSubscription throws naming
# the missing variable rather than falling back to another tier.
#
# Current prices, which the PayPal plans must be created at:
#   standard $39/mo    pro $79/mo    elite $99/mo
PAYPAL_PLAN_STANDARD=
PAYPAL_PLAN_PRO=
PAYPAL_PLAN_ELITE=
# [optional, server only] Where PayPal returns the payer after they approve or
# abandon a subscription. Absolute URLs, e.g.
# https://masseurmatch.com/subscription?paypal=return
PAYPAL_RETURN_URL=
PAYPAL_CANCEL_URL=


# --- Observability & bot protection (packages/config) -----------------------
# All four are OPTIONAL. Absent means the feature is off, the build is green,
# and nothing throws — see packages/config/observability.ts. A deployment that
# cannot start because an optional vendor is unconfigured has traded a
# monitoring gap for an outage.
#
# [optional] Cloudflare Turnstile. BOTH must be set or the check is skipped
# entirely — a half-configured widget must never read as enforcement. When set,
# sign-in verifies the token server-side and rejects a failure.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# [optional] Sentry DSN. Today `reportError` logs; wiring @sentry/nextjs is a
# one-function change once this exists, because every call site already routes
# through that function.
NEXT_PUBLIC_SENTRY_DSN=
# [optional] Overrides the environment name attached to a report. Defaults to
# VERCEL_ENV, so previews are already distinguishable from production.
SENTRY_ENVIRONMENT=
