# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
.pnp
.pnp.js
.pnpm-store

# next.js
.next/
out/

# build output
build/
dist/

# testing
coverage/

# turborepo
.turbo

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log

# env files — NEVER commit real values. Only .env.example is tracked.
#
# `.env*` is listed even though `.env` + `.env.*` already cover every real
# case: `vercel link` appends that exact pattern to this file when it does not
# find it, and it appends at the END — after the negation below. Git is
# last-match-wins, so that append silently re-ignores .env.example and the one
# file that documents every required variable stops being tracked. Keeping the
# pattern here means the CLI finds it and leaves the file alone.
#
# The negation must stay LAST in this block for the same reason.
.env
.env.*
.env*
!.env.example

# secrets / credentials
*.key
*.p8
*.p12
*.pfx
*.crt
service-account*.json
credentials*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editors
.idea/
.vscode/*
!.vscode/extensions.json

# Playwright
/test-results/
/playwright-report/
